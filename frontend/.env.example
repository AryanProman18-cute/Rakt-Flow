# Public frontend configuration. Set these in Vercel Project Settings > Environment Variables.
VITE_API_BASE_URL=https://your-raktflow-api.onrender.com
VITE_FIREBASE_API_KEY=
# In production, use the app host (for example raktflow-demo123.vercel.app)
# when /__/auth/* is reverse-proxied to your-project.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
