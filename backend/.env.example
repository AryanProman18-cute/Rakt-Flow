APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.region.aws.neon.tech/raktflow?ssl=require
FIREBASE_PROJECT_ID=raktflow-dev
FIREBASE_CREDENTIALS_JSON=
CORS_ORIGINS=["http://localhost:5173"]
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ALLOW_DEV_AUTH=false
REQUISITION_STORAGE_DIR=./var/requisitions
MAX_DB_CONNECTIONS=5
BOOTSTRAP_ADMIN_EMAIL=your-admin-email@example.com
PUBLIC_APP_URL=http://localhost:5173
# Leave both blank until a real sender domain is verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=chemnaam@gmail.com
CONTACT_EMAIL=chemnaam@gmail.com
CONTACT_PHONE=9908840322
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PII_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=replace-with-at-least-24-random-characters
SCREENING_MIN_AGE=18
SCREENING_MAX_AGE=65
SCREENING_MIN_WEIGHT_KG=45
SCREENING_WHOLE_BLOOD_INTERVAL_DAYS=90
SCREENING_ANTIBIOTIC_REVIEW_DAYS=14
SCREENING_TATTOO_REVIEW_DAYS=180
SCREENING_SURGERY_REVIEW_DAYS=180
SCREENING_MALARIA_REVIEW_DAYS=90
SCREENING_DELIVERY_REVIEW_DAYS=365
DATA_RIGHTS_RESPONSE_DAYS=30
